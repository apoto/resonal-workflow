{
  "name": "mv-style-plate-swap",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "plate-swap: flat fields swapped on bar lines + still character plates + extra-bold gothic lyrics that wipe in and persist (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "lint": "tsx src/lint-scene.ts",
    "render": "remotion render LyricVideo out/main.mp4 --concurrency=4",
    "render:short": "remotion render ShortVideo out/short.mp4 --concurrency=4",
    "fonts": "remotion still FontCompare out/fontcompare.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.481",
    "@remotion/google-fonts": "4.0.481",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.481"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "tsx": "^4.19.0",
    "typescript": "5.8.2"
  }
}
