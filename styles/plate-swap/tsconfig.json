{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": [
      "DOM",
      "ES2020"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "node_modules/@types/react/jsx-runtime"
      ],
      "react-dom": [
        "node_modules/@types/react-dom"
      ],
      "remotion": [
        "node_modules/remotion"
      ],
      "@remotion/*": [
        "node_modules/@remotion/*"
      ],
      "@remotion/google-fonts/*": [
        "node_modules/@remotion/google-fonts/dist/cjs/*"
      ]
    }
  },
  "include": [
    "src",
    "../_mv-kit"
  ]
}